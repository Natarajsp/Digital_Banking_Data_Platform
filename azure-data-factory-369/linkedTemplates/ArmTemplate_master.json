{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azure-data-factory-369"
		},
		"LS_AzureSqlDB_Target_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDB_Target'"
		},
		"LS_LandingZone_SQL_DB_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_LandingZone_SQL_DB'"
		},
		"LS_AzureSqlDB_Target_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mssqlazureserver.database.windows.net"
		},
		"LS_AzureSqlDB_Target_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().database_name}"
		},
		"LS_AzureSqlDB_Target_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nataraj"
		},
		"LS_LandingZone_SQL_DB_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurestgaccount.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azure-data-factory-369_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSqlDB_Target_password": {
						"value": "[parameters('LS_AzureSqlDB_Target_password')]"
					},
					"LS_LandingZone_SQL_DB_accountKey": {
						"value": "[parameters('LS_LandingZone_SQL_DB_accountKey')]"
					},
					"LS_AzureSqlDB_Target_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDB_Target_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDB_Target_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDB_Target_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDB_Target_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDB_Target_properties_typeProperties_userName')]"
					},
					"LS_LandingZone_SQL_DB_properties_typeProperties_url": {
						"value": "[parameters('LS_LandingZone_SQL_DB_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}